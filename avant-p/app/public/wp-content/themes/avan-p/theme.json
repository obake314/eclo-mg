{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "color": {
      "palette": [
        {
          "color": "#333333",
          "name": "Text",
          "slug": "text"
        },
        {
          "color": "#666666",
          "name": "Muted",
          "slug": "muted"
        },
        {
          "color": "#e9ba53",
          "name": "Gold",
          "slug": "gold"
        },
        {
          "color": "#f8f8f8",
          "name": "Soft Gray",
          "slug": "soft-gray"
        },
        {
          "color": "#ffffff",
          "name": "White",
          "slug": "white"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Yu Gothic\", YuGothic, \"Hiragino Kaku Gothic ProN\", \"Hiragino Sans\", Meiryo, sans-serif",
          "name": "System Japanese",
          "slug": "system-japanese"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#333333"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-japanese)",
      "fontSize": "16px",
      "lineHeight": "1.8"
    },
    "spacing": {
      "blockGap": "0"
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-home",
      "postTypes": [
        "page"
      ],
      "title": "Home"
    }
  ]
}
