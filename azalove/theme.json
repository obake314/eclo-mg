{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": false,
    "spacing": {
      "padding": false,
      "margin": false,
      "blockGap": false
    },
    "typography": {
      "fluid": false,
      "dropCap": false,
      "fontSizes": [],
      "fontFamilies": []
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false
    }
  },
  "styles": {
    "color": {
      "background": "#fff",
      "text": "#2d383d"
    },
    "typography": {
      "fontSize": "16px",
      "lineHeight": "1.85",
      "fontWeight": "400",
      "letterSpacing": "0"
    }
  }
}
